<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title id="title" class="ui-title">Easygard Mobile Amtgard</title>
	<link rel="apple-touch-icon" href="/apple-touch-iphone.png" />
	<link rel="stylesheet" href="/lib/jquery.mobile-1.4.5.min.css">
	<link rel="stylesheet" href="/lib/jqm-demos.css">
	<script src="/lib/jquery.min.js"></script>
	<script src="/lib/index.js"></script>
	<script src="/lib/jquery.mobile-1.4.5.min.js"></script>
	<script>
	  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
	  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
	  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
	  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

	  ga('create', 'UA-57944446-1', 'auto');
	  ga('send', 'pageview');

	</script>
	<script>
	  if ('serviceWorker' in navigator) {
	    window.addEventListener('load', function () {
	      navigator.serviceWorker.register('/service-worker.js').then(function (reg) {
	        function showUpdateBanner() {
	          if (document.getElementById('eg-update-modal')) return;
	          // Append to <html> instead of <body>: jQuery Mobile rewrites body
	          // content when it sets up its page container, which can wipe out
	          // anything appended directly to body.
	          var modal = document.createElement('div');
	          modal.id = 'eg-update-modal';
	          modal.setAttribute('style',
	            'position:fixed !important;inset:0 !important;z-index:2147483647 !important;' +
	            'display:flex !important;align-items:center !important;justify-content:center !important;' +
	            'background:rgba(0,0,0,0.55) !important;' +
	            'font-family:sans-serif !important;visibility:visible !important;opacity:1 !important;');
	          modal.innerHTML =
	            '<div role="dialog" aria-modal="true" aria-labelledby="eg-modal-title" style="' +
	              'background:#fff;border-radius:10px;max-width:380px;width:calc(100% - 40px);' +
	              'padding:24px;box-shadow:0 10px 40px rgba(0,0,0,0.4);text-align:center;' +
	              'box-sizing:border-box;">' +
	              '<h2 id="eg-modal-title" style="margin:0 0 8px;font-size:20px;color:#2c3e50;">' +
	                'Easygard has been updated' +
	              '</h2>' +
	              '<p style="margin:0 0 20px;font-size:14px;color:#555;line-height:1.4;">' +
	                'New content is available. See what changed, or refresh to load the latest.' +
	              '</p>' +
	              '<button id="eg-modal-changes" type="button" style="' +
	                'display:block;width:100%;margin:0 0 8px;padding:12px;' +
	                'background:#3a8a3a;color:#fff;border:0;border-radius:6px;' +
	                'font-size:15px;font-weight:bold;cursor:pointer;">' +
	                'See what changed' +
	              '</button>' +
	              '<button id="eg-modal-reload" type="button" style="' +
	                'display:block;width:100%;padding:12px;' +
	                'background:#eee;color:#333;border:0;border-radius:6px;' +
	                'font-size:15px;cursor:pointer;">' +
	                'Refresh page' +
	              '</button>' +
	            '</div>';
	          // Both actions navigate, so the new SW serves fresh content.
	          modal.querySelector('#eg-modal-changes').addEventListener('click', function () {
	            window.location.assign('/changes/');
	          });
	          modal.querySelector('#eg-modal-reload').addEventListener('click', function () {
	            window.location.reload();
	          });
	          document.documentElement.appendChild(modal);
	          // Re-attach if anything (JQM page transition, etc.) removes it.
	          var observer = new MutationObserver(function () {
	            if (!document.getElementById('eg-update-modal')) {
	              document.documentElement.appendChild(modal);
	            }
	          });
	          observer.observe(document.documentElement, { childList: true, subtree: true });
	          setTimeout(function () { observer.disconnect(); }, 60000);
	        }
	        // For testing: run window.__egShowUpdateBanner() in DevTools console.
	        window.__egShowUpdateBanner = showUpdateBanner;
	        reg.addEventListener('updatefound', function () {
	          var newWorker = reg.installing;
	          if (!newWorker) return;
	          newWorker.addEventListener('statechange', function () {
	            // controller is non-null only after a previous SW has been installed,
	            // so this fires for updates and not the user's first-ever visit.
	            if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
	              showUpdateBanner();
	            }
	          });
	        });
	      });
	    });
	  }
	</script>
</head>
<body>
<%= yield %>

<script>
  (function () {
    var label = document.createElement('div');
    label.textContent = <%= cache_version.to_json %>;
    label.setAttribute('style',
      'position:fixed !important;right:6px !important;bottom:4px !important;' +
      'z-index:2147483646 !important;font:11px sans-serif !important;' +
      'color:#888 !important;background:rgba(255,255,255,0.7) !important;' +
      'padding:2px 6px !important;border-radius:3px !important;' +
      'pointer-events:none !important;');
    document.documentElement.appendChild(label);
  })();
</script>
</body>
</html>